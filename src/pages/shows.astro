---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import PageHead from '@components/PageHead.astro';
import Gallery from '@components/Gallery.astro';
import { PAGES_SEO } from '@/consts';
import { getTrabajosByCategory, CATEGORY_LABELS } from '@lib/trabajos';

const seo = PAGES_SEO.shows;
const works = await getTrabajosByCategory('Shows');
---

<Layout title={seo.title} description={seo.description}>
  <Header current="/shows" />
  <main>
    <PageHead title={CATEGORY_LABELS.Shows} count={works.length} />
    <Gallery filter="Shows" />
  </main>
  <Footer />
</Layout>
